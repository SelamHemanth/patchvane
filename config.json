  "ai": {
    "_about": "The assistant will use any provider it has an API key for. Keys come from the environment (OPENAI_API_KEY, ANTHROPIC_API_KEY, GEMINI_API_KEY and so on) or from the Settings page, which writes them to secrets.json. They are never written to this file.",
    "_models": "Leave a provider out to use its default model. Put a name here to pin one, e.g. \"openai\": \"gpt-5.6-sol\".",
    "models": {
      "gemini": "gemini-3.1-flash-lite"
    },
    "_routing": "On Auto, the question is classified as code, writing, reasoning, summary or long, and the providers best suited to it are tried first. If one is rate limited or overloaded, the next one takes the question.",
    "_endpoints": "Point a provider at a different address, for a company gateway or a regional endpoint. It must speak the same wire format, e.g. \"openai\": \"https://gateway.example.com/v1\".",
    "endpoints": {},
    "_classify": "The collector asks a model about threads whose status it could only guess from the text. It never overrules a commit or a patchwork state. collect.py --no-ai turns it off; classify_limit caps how many threads one collection may ask about.",
    "classify_limit": 200
  },
  "signin": {
    "_about": "Addresses allowed to sign in with a Gmail app password. The tracked address above is always allowed. Everyone listed still has to log into their own mailbox to get in, so this grants read access to this dashboard and nothing else. MAINLINE_ALLOW_EMAILS overrides this list.",
    "emails": []
  },
  "_identity": "Left blank on purpose: this server collects for whoever signs in, and each of them gets their own dashboard. Set MAINLINE_OWNER only if you want a default for passphrase sign-in without typing an address."
}
