  "app_name": "Patchvane",
  "app_tagline": "upstream patch tracker",
  "name": "",
  "email": "",
  "_comment": "Everything below is fetched over the network. No local kernel tree or submission directory is needed.",
  "user_agent": "patchvane/2.0",
  "cache_hours": 3,
  "netdev_outstanding_cap": 15,
  "auto_refresh_minutes": 15,
  "lore": {
    "enabled": true,
    "base": "https://lore.kernel.org",
    "max_messages": 3000,
    "thread_workers": 4
