.env
secrets.json

# Written by run.sh for the server it backgrounds.
.patchvane.pid
patchvane.log

# One directory per person who signed in: their collected patches and their
# notes.  Nobody else's business, and rebuilt from public archives anyway.
people/
cache/
__pycache__/

# Certificates netcheck.py --save-ca pulls off this network, to be installed
# on this machine.  They belong to whoever runs it, not to the project.
network-ca/

# Older single-address layouts, before people/ existed.
data.json
notes.json
dashboard.html
secrets.json*
