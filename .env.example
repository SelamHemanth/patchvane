# Nothing here identifies a person: whoever signs in gets a dashboard of
# their own patches, so there is no address to set. Every setting below has
# a working default, so there is nothing you have to fill in to start.
#
# ./run.sh copies this to .env itself on a first run and generates the
# secret, so the whole of the setup is:
#
#   ./run.sh

# Signs the session cookie. Any long random string; changing it signs
# everybody out.
#   openssl rand -hex 32
export PATCHVANE_SECRET=

# Sign in with a Gmail address and a Google app password, checked against
# that mailbox. This is what makes it work for anyone without being told
# who they are.
export PATCHVANE_ALLOW_GMAIL=1

# A passphrase instead, for hosts that block outbound IMAP. Leave blank to
# offer only Gmail; set both to offer the choice.
#   python3 serve.py --hash-passphrase
# Keep the quotes: the hash has $ in it, and unquoted the shell would eat
# the halves after each one when this file is read.
export PATCHVANE_PASSPHRASE_HASH=''

# Require both rather than either.
# export PATCHVANE_REQUIRE_BOTH=1

# Narrow sign-in to particular addresses. Leave unset to let anyone in who
# can log into their own mailbox.
# export PATCHVANE_ALLOW_EMAILS=someone@gmail.com,someone.else@gmail.com

# Whose patches to collect when somebody signs in with a passphrase and does
# not say. Only a default for the sign-in form; leave unset and it asks.
# export PATCHVANE_OWNER=you@example.com

# Where to listen, and how often to collect. 0.0.0.0 exposes it to the
# network, so only with a proxy and PATCHVANE_MODE=cloud in front.
export PATCHVANE_HOST=127.0.0.1
export PATCHVANE_PORT=8787
export PATCHVANE_INTERVAL=30

# Stop refreshing a dashboard nobody has signed into for this long.
# export PATCHVANE_KEEP_DAYS=14

# Wrong sign-ins from one address before it is made to wait.
export PATCHVANE_LOGIN_TRIES=5

# On a network that opens TLS and re-signs it, point Python at the
# certificate doing that, or nothing can be read and every collection
# comes back empty. python3 netcheck.py says whether this is you.
# Trusting it system wide with update-ca-certificates is tidier; this is
# for when you cannot.
# export SSL_CERT_FILE=/path/to/your-ca.pem

# Assistant keys. Any one is enough; more means it can fail over between
# them. They can also be typed into Settings instead of kept here.
# export GEMINI_API_KEY=
# export OPENAI_API_KEY=
# export ANTHROPIC_API_KEY=
